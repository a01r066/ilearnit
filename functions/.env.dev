# Non-secret params for the ilearnit-dev project (firebase use dev).
# Secrets (keys, service accounts) go in Secret Manager, never here.
ANDROID_PACKAGE_NAME=info.ilearnit.app.dev
APPLE_BUNDLE_ID=info.ilearnit.app.dev
# Numeric Apple ID of the app in App Store Connect. Leave empty if this
# bundle has no App Store record — only Sandbox is then verified.
APPLE_APP_ID=

# App Check enforcement for client callables (monitor first).
ENFORCE_APP_CHECK=false
