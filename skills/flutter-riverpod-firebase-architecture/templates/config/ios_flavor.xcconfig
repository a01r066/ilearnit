// ios/Flutter/devDebug.xcconfig (repeat for devProfile, devRelease,
// prodDebug, prodProfile, prodRelease with each project's value).
#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

BUNDLE_DISPLAY_NAME=MyApp Dev

// REVERSED_CLIENT_ID of the iOS OAuth client in THIS flavor's Firebase
// project. Info.plist → CFBundleURLTypes → CFBundleURLSchemes:
//   <string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.REPLACE_ME
