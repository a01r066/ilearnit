# functions/.env.<project-alias>   (non-secret params; one file per Firebase project)
ANDROID_PACKAGE_NAME=com.example.app
APPLE_BUNDLE_ID=com.example.app
# Numeric Apple ID of the app (App Store Connect → App Information).
# Empty → only Sandbox is used (fine for the dev project).
APPLE_APP_ID=
ENFORCE_APP_CHECK=false

# Secrets (never in .env):
#   firebase functions:secrets:set APPLE_IAP_KEY_ID
#   firebase functions:secrets:set APPLE_IAP_ISSUER_ID
#   firebase functions:secrets:set APPLE_IAP_PRIVATE_KEY      # paste the .p8
#   firebase functions:secrets:set GOOGLE_PLAY_SERVICE_ACCOUNT  # full JSON
# package.json: "@apple/app-store-server-library"
