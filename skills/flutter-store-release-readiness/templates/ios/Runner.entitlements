<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Set CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements in EVERY Runner
  build configuration (Debug/Profile/Release × each flavor). Enable the
  same capabilities on each App ID (dev and prod bundle ids).
  Remove keys for capabilities you don't use.
-->
<plist version="1.0">
<dict>
  <!-- Push (FCM via APNs). Archive/export switches to production. -->
  <key>aps-environment</key>
  <string>development</string>
  <!-- Sign in with Apple — required if you offer any third-party login (Guideline 4.8). -->
  <key>com.apple.developer.applesignin</key>
  <array>
    <string>Default</string>
  </array>
  <!-- App Attest (Firebase App Check on iOS 14+). -->
  <key>com.apple.developer.devicecheck.appattest-environment</key>
  <string>production</string>
</dict>
</plist>
