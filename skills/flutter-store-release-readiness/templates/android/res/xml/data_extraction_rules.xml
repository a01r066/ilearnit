<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Re-downloadable, per-account files (OfflineStorage dirs
     under Application Support = files/) must not be backed up or moved to
     a new device. Keep the list in sync with OfflineStorage.dir(names). -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="file" path="downloads/" />
    <exclude domain="file" path="attachments/" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="file" path="downloads/" />
    <exclude domain="file" path="attachments/" />
  </device-transfer>
</data-extraction-rules>
