<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Capabilities the app uses. The App ID (both info.ilearnit.app and
  info.ilearnit.app.dev) must have the matching capabilities enabled —
  with automatic signing Xcode does this when you build.
    • Push Notifications  (FCM via APNs). Export for App Store switches
      aps-environment to "production" automatically.
    • Sign in with Apple
    • App Attest           (Firebase App Check provider on iOS)
-->
<plist version="1.0">
<dict>
  <key>aps-environment</key>
  <string>development</string>
  <key>com.apple.developer.applesignin</key>
  <array>
    <string>Default</string>
  </array>
  <key>com.apple.developer.devicecheck.appattest-environment</key>
  <string>production</string>
</dict>
</plist>
